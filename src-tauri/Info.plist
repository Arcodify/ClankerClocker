<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Without this, macOS App Nap can suspend/throttle ClankerClocker's background
         input-monitor thread whenever the app isn't the focused/frontmost app, which is
         almost always true for a tray app. That made the global keyboard/mouse listener
         only receive events while ClankerClocker itself was focused. -->
    <key>NSAppSleepDisabled</key>
    <true/>
    <!-- Required for the AppleScript "tell application System Events" call in
         monitor/window.rs that reads the active app/window title. Without this
         key, macOS silently denies the Apple Event (no permission prompt ever
         appears) instead of asking the user for Automation access. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>ClankerClocker reads the name of the app and window you have focused, to track your work activity.</string>
</dict>
</plist>
