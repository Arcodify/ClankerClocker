<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Without this, macOS App Nap can suspend/throttle ClankerClocker's background
         input-monitor thread whenever the app isn't the focused/frontmost app, which is
         almost always true for a tray app. That made the global keyboard/mouse listener
         only receive events while ClankerClocker itself was focused. -->
    <key>NSAppSleepDisabled</key>
    <true/>
</dict>
</plist>
